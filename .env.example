# --- reMarkable (created by `pnpm spike pair <code>`) ---
RMAPI_DEVICE_TOKEN=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Model is a CONFIG value (CLAUDE.md "Model usage"); rotate nightly during dogfood.
DECODE_MODEL=claude-haiku-4-5
DECODE_ESCALATION_MODEL=claude-sonnet-5
DECODE_CONFIDENCE_THRESHOLD=0.7
# Dogfood: rotate the primary model by day-of-year (comma list); leave empty to use DECODE_MODEL.
DECODE_MODEL_ROTATION=claude-haiku-4-5,claude-sonnet-5

# --- Runtime state (embedded DB + encrypted 1-day cache). Default: %LOCALAPPDATA%\dayMarkable or ~/.daymarkable
# DAYMARKABLE_STATE_DIR=

# --- Encryption at rest (generated automatically on first run if empty; 32 bytes base64) ---
DATA_ENCRYPTION_KEY=

# --- Render service (services/render) ---
RENDER_SERVICE_URL=http://127.0.0.1:8787

# --- Milestone 2+ ---
# Local: `pnpm db:dev` serves embedded Postgres (PGlite) on 5433. Production: the compose Postgres URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
PG_POOL_MAX=1
APP_URL=http://localhost:3000
# Resend API key; empty = emails are logged, not sent.
EMAIL_API_KEY=
EMAIL_FROM=dayMarkable <notes@daymarkable.app>
USER_TIMEZONE=America/New_York
USER_EMAIL=

# --- Milestone 4 ---
ADMIN_LOGIN_ID=
ADMIN_PASSWORD_HASH=
