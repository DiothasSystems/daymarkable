{
  "name": "daymarkable",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:live": "DAYMARKABLE_LIVE=1 vitest run --config vitest.live.config.mts",
    "spike": "pnpm --filter @daymarkable/runner spike",
    "dev:run": "pnpm --filter @daymarkable/runner dev:run",
    "db:migrate": "pnpm --filter @daymarkable/db migrate",
    "render:dev": "cd services/render && python -m uvicorn app:app --host 127.0.0.1 --port 8787",
    "render:up": "docker compose up -d render"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
