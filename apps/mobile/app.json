{
  "expo": {
    "name": "ScriptumIQ",
    "slug": "daymarkable",
    "scheme": [
      "scriptumiq",
      "daymarkable"
    ],
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.diothassystems.daymarkable",
      "supportsTablet": false
    },
    "android": {
      "package": "com.diothassystems.daymarkable",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1E2A44"
      },
      "icon": "./assets/play-store-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#F7F0E3"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#F7F0E3",
    "primaryColor": "#1E2A44"
  }
}
