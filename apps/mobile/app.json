{
  "expo": {
    "name": "dayMarkable",
    "slug": "daymarkable",
    "scheme": "daymarkable",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.diothas.daymarkable",
      "supportsTablet": false
    },
    "android": {
      "package": "com.diothas.daymarkable"
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-font"],
    "experiments": { "typedRoutes": true }
  }
}
